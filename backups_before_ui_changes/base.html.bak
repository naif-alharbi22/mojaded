{% load static %}
<!doctype html>
<html lang="ar" dir="rtl" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}مُجدد{% endblock %} | إدارة الاشتراكات</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">

    
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://unpkg.com/htmx.org@1.9.12"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    


    <script>
      document.addEventListener("DOMContentLoaded", function () {
        htmx.on("htmx:afterSwap", (e) => {
          const target = e.detail.target;
          const response = e.detail.xhr?.response;
          if (
            target.matches("dialog.modal, .modal") &&
            response &&
            response.includes("hx-swap-oob")
          ) {
            if (target.dataset.closing) return;
            target.dataset.closing = "true";
            const toastCloseModal = response.match(/data-close-modal="(false|true)"/);
            const shouldCloseFromToast = toastCloseModal ? toastCloseModal[1] === "true" : true;
            const autoClose = target.getAttribute("auto-close")
              ? target.getAttribute("auto-close") == "true"
              : true;
            if (autoClose && shouldCloseFromToast) {
              requestAnimationFrame(() => {
                target.classList.remove("modal-open");
                setTimeout(() => target.remove(), 500);
              });
            }
            return;
          }
        });
      });
    </script>
  
  


  
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.10/dist/full.min.css" rel="stylesheet" type="text/css" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            g: '#00c98d',
            g2: '#00a374',
            g3: '#006b4d',
            dark: '#07090d',
            dark2: '#0c1117',
            dark3: '#111820',
            dark4: '#161f28',
            muted: '#5d8070',
            muted2: '#3a5244',
            textMain: '#dff5ec',
          },
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style type="text/tailwindcss">
    @layer base {
      body {
        @apply font-cairo bg-dark text-textMain antialiased;
        direction: rtl;
      }
    }
    @layer components {
      /* Minimal essential overrides */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { @apply bg-dark; }
      ::-webkit-scrollbar-thumb { @apply bg-g3 rounded-full; }
      
      /* Global Card & Area Overrides for existing generic classes */
      .bg-white, .bg-base-100 { @apply !bg-dark3 !text-textMain; }
      .bg-zinc-100 { @apply !bg-dark4; }
      .shadow-sm, .shadow { @apply !shadow-[0_4px_24px_rgba(0,0,0,0.3)]; }
      .border, .border-zinc-200 { @apply !border-g/10; }
      .text-neutral-800 { @apply !text-white; }
      .text-gray-500 { @apply !text-muted; }

      .table th, .table td { @apply border-b border-g/10 py-3.5 px-4 text-right text-sm; }
      .table thead { @apply bg-black/25; }
      .table thead th { @apply text-[11px] font-semibold tracking-wider text-muted uppercase border-b border-g/20; }
      .table tbody tr { @apply transition-colors hover:bg-g/[4.5%]; }
      
      input:not([type="checkbox"]):not([type="radio"]), select, textarea {
        @apply bg-dark4 border border-g/20 text-textMain rounded-lg outline-none transition-all focus:border-g focus:ring-2 focus:ring-g/15;
      }
    }
  </style>


</head>

  <body class="font-cairo bg-dark text-textMain min-h-screen">

    <!-- Mobile overlay -->
    <div id="sidebar-overlay" class="fixed inset-0 bg-black/60 z-40 hidden [&.show]:block" onclick="closeSidebar()"></div>

    <div class="flex min-h-screen">

      <!-- ─── SIDEBAR ─── -->
      <aside id="sidebar" class="fixed inset-y-0 start-0 z-50 w-[272px] bg-dark2 border-e border-g/10 flex flex-col translate-x-full lg:sticky lg:top-0 lg:h-screen lg:translate-x-0 transition-transform duration-300 [&.open]:translate-x-0">

        <!-- Logo -->
        <div class="p-[1.25rem_1.5rem] flex justify-between items-center border-b border-g/10">
          <span class="text-[20px] font-bold text-g tracking-[-0.5px]">مُجدد</span>
        </div>

        <!-- Menu -->
        <div class="flex-1 p-[1.5rem_1rem] overflow-y-auto flex flex-col gap-6">

          <!-- الرئيسية -->
          <div>
            <p class="text-[11px] font-semibold text-muted2 tracking-widest uppercase mb-2 px-2">الرئيسية</p>
            <ul class="list-none flex flex-col gap-0.5">
              <li>
                <a href="{% url 'dashboard:dashboard' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium bg-g/[12%] text-g border border-g/20 cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4">
                  <i data-lucide="home"></i>
                  <span>لوحة التحكم</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- الإدارة -->
          <div>
            <p class="text-[11px] font-semibold text-muted2 tracking-widest uppercase mb-2 px-2">الإدارة</p>
            <ul class="list-none flex flex-col gap-0.5">
              <li>
                <a href="{% url 'subscriptions:subscriptions' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium text-muted hover:bg-g/[7%] hover:text-textMain cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4">
                  <i data-lucide="credit-card"></i>
                  <span>الاشتراكات</span>
                </a>
              </li>
              <li>
                <a href="{% url 'customers:customers' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium text-muted hover:bg-g/[7%] hover:text-textMain cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4">
                  <i data-lucide="users"></i>
                  <span>العملاء</span>
                </a>
              </li>
              <li>
                <a href="{% url 'subscriptions:plans' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium text-muted hover:bg-g/[7%] hover:text-textMain cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4">
                  <i data-lucide="box"></i>
                  <span>الباقات</span>
                </a>
              </li>
              <li>
                <a href="{% url 'customers:customers' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium text-muted hover:bg-g/[7%] hover:text-textMain cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4">
                  <i data-lucide="puzzle"></i>
                  <span>الإضافات</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- النظام -->
          <div>
            <div class="h-[1px] bg-g/10 my-1"></div>
            <p class="text-[11px] font-semibold text-muted2 tracking-widest uppercase mb-2 px-2" style="margin-top:.75rem">النظام</p>
            <ul class="list-none flex flex-col gap-0.5">
              <li>
                <a href="{% url 'setting:view_settings' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium text-muted hover:bg-g/[7%] hover:text-textMain cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4">
                  <i data-lucide="settings"></i>
                  <span>الإعدادات</span>
                </a>
              </li>
              <li>
                <a href="{% url 'logout' %}" class="flex items-center gap-3 p-[0.55rem_0.75rem] rounded-lg text-sm font-medium text-muted hover:bg-g/[7%] hover:text-textMain cursor-pointer transition-all [&_svg,i]:w-4 [&_svg,i]:h-4" style="color: #e57373;">
                  <i data-lucide="log-out"></i>
                  <span>تسجيل الخروج</span>
                </a>
              </li>
            </ul>
          </div>

        </div>

        <!-- User Footer -->
        <div class="border-t border-g/10 p-4 flex items-center gap-3 bg-dark3">
          <div class="w-[38px] h-[38px] rounded-full bg-g3 text-g flex items-center justify-center font-bold text-[15px] border border-g/20 overflow-hidden flex-shrink-0 [&_img]:w-full [&_img]:h-full [&_img]:object-cover">
            {% if request.user.image %}
              <img src="{{ request.user.image.url }}" alt="Profile Image" />
            {% else %}
              {{ request.user.username|first|upper }}
            {% endif %}
          </div>
          <div>
            <p class="text-sm font-semibold text-textMain">{{ request.user.username }}</p>
            <p class="text-[12px] text-muted mt-0.5">حساب نشط</p>
          </div>
        </div>

      </aside>

      <!-- ─── MAIN AREA ─── -->
      <div class="flex-1 flex flex-col min-w-0">

        <!-- Top Navbar -->
        <nav class="bg-dark/90 backdrop-blur-[14px] border-b border-g/10 p-[0.9rem_1.5rem] flex items-center gap-4 sticky top-0 z-30">
          <!-- Hamburger (mobile) -->
          <button class="bg-none border border-g/20 rounded-[7px] w-9 h-9 flex items-center justify-center cursor-pointer text-muted transition-all hover:border-g hover:text-g lg:hidden" onclick="openSidebar()" id="hamburger-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
          </button>

          <div class="flex-1 text-[16px] font-bold text-g tracking-[-0.3px]">مُجدد</div>

          <!-- User dropdown -->
          <div class="relative">
            <button class="bg-g/[7%] border border-g/20 rounded-lg p-[0.45rem_1rem] text-[13px] font-medium text-textMain cursor-pointer transition-all hover:bg-g/[12%] hover:border-g/35 font-cairo" onclick="toggleUserMenu()" id="user-menu-btn">
              {{ request.user.username }}
            </button>
            <div class="hidden [&.show]:block absolute top-[calc(100%+8px)] left-0 bg-dark3 border border-g/20 rounded-[10px] min-width-[140px] overflow-hidden z-[99] shadow-[0_8px_30px_rgba(0,0,0,0.4)]" id="user-dropdown">
              <a href="{% url 'logout' %}" class="block p-[0.65rem_1rem] text-[13px] text-red-400 transition-colors hover:bg-red-500/10">تسجيل الخروج</a>
            </div>
          </div>
        </nav>

        <!-- Main Content -->
        <main id="main-content" class="p-8 flex-1">
          {% block content %}{% endblock %}
        </main>

      </div>
    </div>

    <script>
      // Sidebar toggle
      function openSidebar() {
        document.getElementById("sidebar").classList.add("open");
        document.getElementById("sidebar-overlay").classList.add("show");
      }
      function closeSidebar() {
        document.getElementById("sidebar").classList.remove("open");
        document.getElementById("sidebar-overlay").classList.remove("show");
      }

      // Show hamburger on mobile
      (function() {
        function checkMobile() {
          const btn = document.getElementById("hamburger-btn");
          if (btn) btn.style.display = window.innerWidth < 1024 ? "flex" : "none";
        }
        checkMobile();
        window.addEventListener("resize", checkMobile);
      })();

      // User dropdown
      function toggleUserMenu() {
        document.getElementById("user-dropdown").classList.toggle("show");
      }
      document.addEventListener("click", function(e) {
        const btn = document.getElementById("user-menu-btn");
        const dd  = document.getElementById("user-dropdown");
        if (btn && dd && !btn.contains(e.target) && !dd.contains(e.target)) {
          dd.classList.remove("show");
        }
      });

      // Lucide icons
      lucide.createIcons();
      document.body.addEventListener("htmx:afterSwap", function () {
        lucide.createIcons();
      });

      // Modal close helper
      document.addEventListener("DOMContentLoaded", function () {
        window.closeModal = function (el) {
          const modal = el.closest("dialog.modal, .modal");
          if (!modal) return;
          modal.classList.remove("modal-open");
          setTimeout(() => modal.remove(), 250);
        };
      });
      // HTMX CSRF setup
      document.body.addEventListener('htmx:configRequest', (event) => {
        const token = document.cookie.split('; ').find(row => row.startsWith('csrftoken='))?.split('=')[1];
        if (token) {
          event.detail.headers['X-CSRFToken'] = token;
        }
      });
      
      // Handle HTMX confirm with SweetAlert2
      document.body.addEventListener('htmx:confirm', function(e) {
          if (e.target.hasAttribute('hx-confirm')) {
              e.preventDefault();
              Swal.fire({
                  title: 'تأكيد الحذف',
                  text: e.detail.question,
                  icon: 'warning',
                  showCancelButton: true,
                  confirmButtonColor: '#e57373',
                  cancelButtonColor: '#5d8070',
                  confirmButtonText: 'نعم، حذف',
                  cancelButtonText: 'إلغاء',
                  background: 'var(--dark3)',
                  color: 'var(--text)',
              }).then((result) => {
                  if (result.isConfirmed) {
                      e.detail.issueRequest(true); // Issue the request
                  }
              });
          }
      });
    </script>
  </body>
</html>
